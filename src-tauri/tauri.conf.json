{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RFC Studio",
  "version": "1.1.0",
  "identifier": "com.hezhitech.rfc-review-studio",
  "build": {
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "splash"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "runtime/": "runtime/"
    },
    "shortDescription": "独立 RFC 方案审核工作台",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
