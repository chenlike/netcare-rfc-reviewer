{
  "name": "rfc-review-studio",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.server.json && vue-tsc -p tsconfig.web.json --noEmit && vite build",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "sample": "node scripts/sample.mjs",
    "check": "tsc -p tsconfig.server.json --noEmit && vue-tsc -p tsconfig.web.json --noEmit && npm test",
    "desktop:prepare": "npm run build && node scripts/desktop-prepare.mjs",
    "desktop:build": "node scripts/desktop-build.mjs build",
    "desktop:dev": "node scripts/desktop-build.mjs dev",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "desktop:portable": "node scripts/portable.mjs",
    "desktop:distributions": "node scripts/distributions.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.87.0",
    "@earendil-works/pi-ai": "0.87.0",
    "cheerio": "^1.1.2",
    "css-what": "6.2.2",
    "jszip": "^3.10.2",
    "mammoth": "^1.11.0",
    "marked": "^18.0.14",
    "pdf-parse": "^2.4.5",
    "sharp": "^0.34.4",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^22.19.0",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "domhandler": "^5.0.3",
    "dompurify": "^3.4.15",
    "lucide-vue-next": "^0.577.0",
    "reka-ui": "^2.10.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "^6.3.6",
    "vue": "^3.5.18",
    "vue-sonner": "^2.0.9",
    "vue-tsc": "^3.0.4"
  }
}
